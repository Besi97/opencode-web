# Copy to .env and fill in what you need. Compose reads .env automatically.

# --- Required for git auth inside the container ---
# GitHub token (classic or fine-grained with repo access). Entrypoint runs `gh auth setup-git`.
GITHUB_TOKEN=

# --- Optional: self-hosted Forgejo/Gitea instance ---
# Setting all three enables the fj CLI and a git credential helper for that host.
FORGEJO_TOKEN=
FORGEJO_URL=
FORGEJO_USER=

# --- Optional: git commit identity ---
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=

# --- Optional: GPG commit signing ---
# In-container path of a mounted private key. When set and readable, the entrypoint
# imports it and enables commit signing (git config --global commit.gpgsign true).
# The key must be exported WITHOUT a passphrase - nothing can prompt for one here.
# Also uncomment the key volume in docker-compose.yaml. Empty disables signing.
# The key's UID email should match GIT_AUTHOR_EMAIL, or forges show commits unverified.
GPG_SIGNING_KEY_PATH=

# --- Optional: Google Stitch MCP (also flip "enabled" in opencode.jsonc) ---
STITCH_API_KEY=

# --- Networking ---
# Port the OpenCode web UI listens on, and the address it binds to on the host.
# The web UI has NO authentication - keep 127.0.0.1 unless behind an authenticating proxy.
OPENCODE_PORT=4096
OPENCODE_BIND=127.0.0.1
# Docker endpoint used by the container's docker CLI.
# Default points at the bundled dind sidecar; set empty to use a mounted socket.
DOCKER_HOST=tcp://docker-in-docker:2375

# --- Storage ---
# State lives in named volumes by default. To bind-mount host directories instead,
# set these to paths (e.g. ./projects) and chown them to UID 1000 first.
OPENCODE_PROJECTS_VOLUME=
OPENCODE_CONFIG_VOLUME=
OPENCODE_SHARE_VOLUME=
OPENCODE_CACHE_VOLUME=
