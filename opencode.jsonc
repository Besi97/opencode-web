{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/instructions/*.md"],
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": { "X-Goog-Api-Key": "{env:STITCH_API_KEY}" },
      "enabled": false,
      "timeout": 300000
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "/home/node/projects/**": "allow"
    }
  }
}
